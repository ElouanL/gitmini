{
  "name": "gitmini-e2e",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "wdio": "wdio run wdio.conf.ts",
    "wdio:web": "wdio run wdio.web.conf.ts",
    "wdio:perf": "wdio run wdio.perf.conf.ts",
    "selftest": "wdio run wdio.selftest.conf.ts",
    "test": "node --import tsx --test \"helpers/*.test.ts\"",
    "lint": "eslint . ../support ../perf",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "selftest:tauri": "wdio run wdio.selftest-tauri.conf.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/types": "^9.32.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "webdriverio": "^9.32.0"
  },
  "description": "WebdriverIO end-to-end test harness for gitmini"
}
